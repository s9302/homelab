<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- Homelab noise suppression (2026-10-16) -->
<group name="local,rootcheck,">
  <!-- lxcfs bind-mounts its fake /proc files under /dev/.lxc in every LXC container.
       Rootcheck flags them as hidden files on every scan (~1000 alerts/day). -->
  <rule id="100510" level="0">
    <if_sid>510</if_sid>
    <match>File '/dev/.lxc</match>
    <description>Rootcheck: ignore lxcfs files under /dev/.lxc (LXC false positive)</description>
  </rule>
</group>

<group name="local,syscheck,">
  <!-- pmxcfs status files that rewrite themselves constantly. Guest configs,
       authkeys and other files under /etc/pve still alert. -->
  <rule id="100550" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/etc/pve/(\.vmlist|\.clusterlog|\.rrd|\.version|\.members|nodes/[^/]+/lrm_status)$</field>
    <description>FIM: ignore volatile Proxmox cluster status files</description>
  </rule>
  <!-- Pi-hole's query log database changes all day long. -->
  <rule id="100551" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/etc/pihole/pihole-FTL\.db(-shm|-wal)?$</field>
    <description>FIM: ignore Pi-hole FTL query database</description>
  </rule>
</group>

<!-- claude-agent (Ubuntu 26.04) uses rust-coreutils: one uutils multicall binary under
     /usr/lib/cargo/bin/coreutils/ that contains strings the old generic trojan
     signatures look for. Verified clean with dpkg -V on 2026-10-16. Scoped to this
     agent and these 10 files only; trojan alerts on any other host or file still fire. -->
<group name="local,rootcheck,">
  <rule id="100511" level="0">
    <if_sid>510</if_sid>
    <location>^(claude-agent) </location>
    <regex type="pcre2">^Trojaned version of file '(/usr)?/bin/(cat|chgrp|chmod|chown|date|echo|env|ls|md5sum|uname)' detected</regex>
    <description>Rootcheck: ignore rust-coreutils trojan false positive on claude-agent</description>
  </rule>
</group>

<!-- Added 2026-11-02: recurring FIM noise found in the Oct 22 and Nov 2 triages.
     Guest .conf files, authorized_keys and ssh_known_hosts under /etc/pve still alert. -->
<group name="local,syscheck,">
  <!-- Daily cluster authkey rotation and pve-daily-update rewriting 76pveproxy. -->
  <rule id="100552" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^(/etc/pve/authkey\.pub(\.old)?|/etc/pve/priv/authkey\.key|/etc/apt/apt\.conf\.d/76pveproxy)$</field>
    <description>FIM: ignore Proxmox daily authkey rotation and 76pveproxy rewrite</description>
  </rule>
  <!-- LVM metadata archives written by nightly vzdump snapshot backups on PVE nodes. -->
  <rule id="100553" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/lvm/(archive/[^/]+\.vg|backup/[^/]+)$</field>
    <description>FIM: ignore LVM metadata archives from snapshot backups</description>
  </rule>
  <!-- /etc/resolv.conf is regenerated by Proxmox on LXC start. LXCs only. -->
  <rule id="100554" level="0">
    <if_sid>550</if_sid>
    <location type="pcre2">^\((pihole|uptime|vaultwarden|monitor|web|romm)\) </location>
    <field name="file" type="pcre2">^/etc/resolv\.conf$</field>
    <description>FIM: ignore resolv.conf rewrites on LXC guests</description>
  </rule>
</group>
