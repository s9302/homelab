[Unit]
Description=Uptime Kuma
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=kuma
Group=kuma
WorkingDirectory=/opt/uptime-kuma-src
# Bind to loopback + tailnet only; the host firewall is belt-and-braces on top.
Environment=NODE_ENV=production
Environment=DATA_DIR=/opt/uptime-kuma/data/
Environment=UPTIME_KUMA_PORT=3001
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uptime-kuma
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
