#!/bin/sh
# Daily OS and Nextcloud update. Repos are pinned to one Alpine release, so moving
# to a new release stays a manual step. An apk upgrade of Nextcloud does not migrate its
# database, so run occ upgrade afterward or Nextcloud stays stuck on its upgrade prompt.
# 2026-11-15: also updates Nextcloud apps (occ app:update --all) and reports failures
# through homelab-notify (journald -> syslog -> Wazuh).
notify() { /usr/local/sbin/homelab-notify "$*"; }
before=$(md5sum /lib/apk/db/installed)
if ! apk update || ! apk upgrade; then
    logger -t apk-upgrade "apk upgrade failed"
    notify "nextcloud apk upgrade FAILED"
    exit 1
fi
if occ status 2>/dev/null | grep -q 'needsDbUpgrade: true'; then
    if occ upgrade; then
        logger -t apk-upgrade "occ upgrade ok"
    else
        logger -t apk-upgrade "occ upgrade FAILED"
        notify "nextcloud occ upgrade FAILED, Nextcloud is probably showing its upgrade page"
    fi
fi
apps=$(occ app:update --all 2>&1)
case "$apps" in
    *"updated"*) logger -t apk-upgrade "apps: $apps"; notify "nextcloud apps updated: $(echo "$apps" | grep updated | tr '\n' ' ')"; apps_changed=1 ;;
    *rror*|*xception*) notify "nextcloud app update problem: $(echo "$apps" | tail -2 | tr '\n' ' ')" ;;
esac
# apk does not restart services, so pick up new PHP and Nextcloud code
if [ "$before" != "$(md5sum /lib/apk/db/installed)" ] || [ -n "${apps_changed:-}" ]; then
    rc-service nextcloud restart
    rc-service nginx reload
fi
